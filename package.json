{
  "name": "echo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Echo : jeu de plateforme 2D en un seul fichier HTML5 (canvas, son synthétisé).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview": "vite preview",
    "test": "vitest run --mode test",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
